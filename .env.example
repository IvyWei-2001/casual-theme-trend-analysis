# Optional environment overrides for local development.
APP_APP_NAME=casual-theme-trend-analysis
APP_ENVIRONMENT=development
APP_DATABASE_PATH=data/casual_theme_trends.duckdb
APP_EXPORT_DIRECTORY=data/exports
APP_METADATA_CACHE_MAX_AGE_DAYS=14
APP_LOG_LEVEL=INFO

# Sensor Tower market request and local selection settings.
APP_SENSOR_TOWER_API_URL=https://api.sensortower.com
APP_SENSOR_TOWER_ENDPOINT_PATH=/v1/unified/sales_report_estimates_comparison_attributes
APP_SENSOR_TOWER_CATEGORY=7012
APP_SENSOR_TOWER_COUNTRY=WW
APP_SENSOR_TOWER_DEVICE_TYPE=total
APP_SENSOR_TOWER_CUSTOM_TAGS_MODE=include_unified_apps
APP_SENSOR_TOWER_DATA_MODEL=DM_2025_Q2
APP_SENSOR_TOWER_FILTER_FIELD_NAME=Game Genre
APP_SENSOR_TOWER_FILTER_GLOBAL=true
APP_SENSOR_TOWER_FILTER_EXCLUDE=false
APP_SENSOR_TOWER_API_LIMIT=1200
APP_SENSOR_TOWER_FINAL_TOP_N=1000
APP_SENSOR_TOWER_ALLOWED_GENRES=["Puzzle","Tabletop"]
APP_SENSOR_TOWER_EXCLUDE_CHINA_REVENUE_MARKET=true
APP_SENSOR_TOWER_SCOPE_NAME=casual_puzzle_tabletop
APP_SENSOR_TOWER_TIMEOUT_SECONDS=30.0

# Sensor Tower unified app metadata enrichment settings.
APP_SENSOR_TOWER_METADATA_ENDPOINT_PATH=/v1/unified/apps
APP_SENSOR_TOWER_METADATA_BATCH_SIZE=50
APP_SENSOR_TOWER_METADATA_APP_ID_TYPE=unified
APP_SENSOR_TOWER_METADATA_FIELDS=["name","publisher","android_publisher_ids","itunes_publisher_ids","android_apps","itunes_apps","unified_app_id"]
APP_SENSOR_TOWER_METADATA_MAX_RETRIES=2
APP_SENSOR_TOWER_METADATA_RETRY_DELAY_SECONDS=1.5
APP_SENSOR_TOWER_METADATA_BATCH_DELAY_SECONDS=0.3

# Optional YAML path. Leave unset to use the defaults.
# APP_CONFIG_FILE=configs/app.yaml

# Integration credentials are intentionally optional for local bootstrap.
# APP_SENSOR_TOWER_AUTH_TOKEN=
# Feishu FEISHU-001 is read-only field inspection. Keep all target values
# local or in GitHub Secrets; never commit real identifiers or credentials.
APP_FEISHU_API_BASE_URL=https://open.feishu.cn
# APP_FEISHU_APP_ID=your-feishu-app-id
# APP_FEISHU_APP_SECRET=your-feishu-app-secret
# APP_FEISHU_BITABLE_APP_TOKEN=your-feishu-app-token
# APP_FEISHU_BITABLE_TABLE_ID=tbl_your_table_id
# APP_FEISHU_BITABLE_VIEW_ID=vew_your_view_id
APP_FEISHU_TIMEOUT_SECONDS=20
