# Optional environment overrides for local development.
APP_APP_NAME=casual-theme-trend-analysis
APP_ENVIRONMENT=development
APP_DATABASE_PATH=data/casual_theme_trends.duckdb
APP_LOG_LEVEL=INFO

# Sensor Tower market request and local selection settings.
APP_SENSOR_TOWER_API_URL=https://api.sensortower.com
APP_SENSOR_TOWER_API_LIMIT=1200
APP_SENSOR_TOWER_FINAL_TOP_N=1000
APP_SENSOR_TOWER_ALLOWED_GENRES=["Puzzle","Tabletop"]
APP_SENSOR_TOWER_EXCLUDE_CHINA_REVENUE_MARKET=true
APP_SENSOR_TOWER_SCOPE_NAME=casual_puzzle_tabletop
APP_SENSOR_TOWER_TIMEOUT_SECONDS=30.0

# Optional YAML path. Leave unset to use the defaults.
# APP_CONFIG_FILE=configs/app.yaml

# Integration credentials are intentionally optional for local bootstrap.
# APP_SENSOR_TOWER_AUTH_TOKEN=
# APP_FEISHU_APP_ID=
# APP_FEISHU_APP_SECRET=
